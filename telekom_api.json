{
  "_comment": "Telekom webshop API. Placeholders: {category}, {page}, {size}. MinPrice/MaxPrice are widened from the browser's 990/137990 so new cheaper or pricier devices are not filtered out.",
  "url": "https://www.telekom.mk/api/webshop/getDevices",
  "method": "POST",
  "category": "MKT00006",
  "headers": {
    "Origin": "https://www.telekom.mk",
    "Referer": "https://www.telekom.mk/"
  },
  "body": {
    "Page": "{page}",
    "Size": "{size}",
    "Paging": true,
    "TotalItems": 0,
    "CategoryId": "{category}",
    "Manufacturers": [],
    "Promotions": [],
    "MinPrice": "0",
    "MaxPrice": "9999999",
    "SortTypeId": "0",
    "PreselectedFilters": [],
    "IsBusiness": false
  },
  "paging": {"mode": "page", "start": 1, "size": 500},
  "devices_path": "devices",
  "total_path": "total",
  "id_field": "Id",
  "categories_url": "https://www.telekom.mk/api/webshop/GetAllCategories"
}
